# Local mode needs NO configuration. Secrets are generated in data/ on first run.
# Every variable below is only needed when switching a component to Azure.

# MEDIFLOW_BUS_MODE=azure
# MEDIFLOW_SERVICEBUS_NAMESPACE=<name>.servicebus.windows.net

# MEDIFLOW_STORAGE_MODE=azure
# MEDIFLOW_STORAGE_ACCOUNT=<account>

# MEDIFLOW_AI_MODE=azure               # PAID - Azure OpenAI
# MEDIFLOW_AOAI_ENDPOINT=https://<name>.openai.azure.com/
# MEDIFLOW_AOAI_DEPLOYMENT=gpt-4o-mini

# MEDIFLOW_EXTRACTION_MODE=azure       # Document Intelligence (F0 free tier available)
# MEDIFLOW_DOCINTEL_ENDPOINT=https://<name>.cognitiveservices.azure.com/

# MEDIFLOW_AUTH_MODE=entra             # Microsoft Entra ID tokens
# MEDIFLOW_ENTRA_TENANT_ID=<tenant-guid>
# MEDIFLOW_ENTRA_API_AUDIENCE=api://mediflow

# PATIENT_DATABASE_URL=mssql+pyodbc://@<server>.database.windows.net/mediflow-patient?driver=ODBC+Driver+18+for+SQL+Server&Authentication=ActiveDirectoryMsi
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Demo helpers
# MEDIFLOW_NOTIFY_FAILURE_RATE=0.3     # simulate a flaky email/WhatsApp provider (retries + DLQ)
